# Copy to .env for local use. On Vercel, add these under Project > Settings > Environment Variables.
# Never commit real values.

# The passcode the two of you type once per phone. At least 8 characters; longer is better.
TEAM_PASSCODE=

# Reading recordings. Create a key at https://platform.claude.com (billing is per use).
ANTHROPIC_API_KEY=
# Optional. Model IDs change; see https://platform.claude.com/docs/en/about-claude/models/overview
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Shared storage. From your Supabase project's API settings. Use the secret / service_role key,
# NOT the anon / publishable key. It is only ever used on the server.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
